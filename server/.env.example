# 数据库连接(此文件不入库,模板见 .env.example)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=yinkai_web
PORT=3001
# JWT 密钥:生产环境(NODE_ENV=production)必须设置,否则服务拒绝启动;生成:openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# CORS 白名单:允许访问 API 的前端源,逗号分隔(生产必填;开发模式自动放行 localhost)
# 整站 VPS 部署填站点域名;Netlify+API 分离部署填 Netlify 域名
# FRONTEND_ORIGIN=https://www.example.com,https://example.com
# 运行环境:production 时启用上述强制校验(pm2 的 ecosystem.config.cjs 已注入)
# NODE_ENV=production

# 官网表单邮件(联系表单 /api/contact、职位申请 /api/apply 经 SMTP 发送通知)
# 留空时两个接口返回 503,前端提示提交失败;Netlify 静态部署不经过此处(仍走 Netlify Forms)
# 腾讯企业邮:smtp.exmail.qq.com 465 | 163:smtp.163.com 465(密码填授权码) | Gmail:smtp.gmail.com 465(应用专用密码)
# SMTP_HOST=smtp.exmail.qq.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=noreply@example.com
# SMTP_PASS=change-me
# 发件人显示(缺省用 SMTP_USER);收件人逗号分隔
# MAIL_FROM=寅铠官网 <noreply@example.com>
# MAIL_TO=lukecao@ykautomus.com,lujiacao@163.com
