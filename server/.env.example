# 数据库连接(此文件不入库,模板见 .env.example)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=yinkai_web
PORT=3001
# JWT 密钥:生产环境(NODE_ENV=production)必须设置,否则服务拒绝启动
JWT_SECRET=change-me-to-a-long-random-string
# CORS 白名单:允许访问 API 的前端源,逗号分隔(生产必填;开发模式自动放行 localhost)
# FRONTEND_ORIGIN=https://yinkai.netlify.app,https://20010811yu.github.io
# 运行环境:production 时启用上述强制校验
# NODE_ENV=production
